# Copy this file to .env.local and fill in real values.
# .env* is already gitignored, so .env.local will never be committed.

# ── Firebase Client SDK (public — safe to expose to the browser) ──────────
# Firebase Console → Project settings → General → "Your apps" → SDK setup and configuration
FIREBASE_API_KEY=AIzaSyDGP7OToL3pzLkiOSY6hWEwZVEIOpZQKRI
FIREBASE_AUTH_DOMAIN=lcm-asahi.firebaseapp.com
FIREBASE_PROJECT_ID=lcm-asahi
FIREBASE_STORAGE_BUCKET=gs://lcm-asahi.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=757624877135
FIREBASE_APP_ID=1:757624877135:web:9a2836ad508e542601fa3a
# ── Firebase Admin SDK (server-only secret — never expose to the client) ──
# Firebase Console → Project settings → Service accounts → Generate new private key
# Downloads a JSON file. Base64-encode the ENTIRE file into a single line:
#   macOS/Linux:  base64 -i service-account.json | tr -d '\n'
# Never commit the raw JSON file.
FIREBASE_SERVICE_ACCOUNT_

# Session cookie lifetime in seconds (Firebase createSessionCookie max is 14 days = 1209600)
SESSION_COOKIE_MAX_AGE_SECONDS=432000

FIRESTORE_DATABASE_ID=lcm-asahi
